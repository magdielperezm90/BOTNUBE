//@version=5
// =====================================================================
//  RUPTURA PDH/PDL — ESTUDIO DE CONTINUACIÓN (Laboratorio)
//
//  Qué hace:
//   1. Marca el alto (PDH) y el bajo (PDL) del día anterior
//   2. Detecta la PRIMERA ruptura de cada nivel en el día
//   3. Mide cuántos puntos continúa el precio más allá del nivel
//      (excursión máxima hasta el cierre del día)
//   4. Mide también el retroceso: cuánto regresa en contra tras romper
//   5. Resume todo en una tabla de estadísticas (arriba a la derecha)
//
//  Cómo leer la tabla:
//   - N            = número de rupturas registradas
//   - Media / Mediana / Máx = puntos de continuación tras la ruptura
//   - >= Objetivo  = % de rupturas que avanzaron al menos X puntos
//   - Retroceso    = promedio de puntos que regresó en contra tras romper
//
//  Nota: cada punto de MNQ = $2 por contrato.
//  El día se define por la sesión completa del futuro (Globex).
//  Si quieres medir solo horario regular, cambia el gráfico a
//  "Horas de mercado regulares" y el script se adapta solo.
// =====================================================================

indicator("Ruptura PDH/PDL — Continuación (Lab)", overlay=true,
     max_labels_count=500, max_lines_count=500)

// ------------------------- PARÁMETROS -------------------------
diasAnalisis = input.int(30, "Días a analizar (hacia atrás)", minval=5, maxval=90)
modoRuptura  = input.string("Cierre", "Qué cuenta como ruptura",
     options=["Cierre", "Toque"],
     tooltip="Cierre: la vela debe CERRAR fuera del nivel. Toque: basta que la mecha lo cruce.")
objetivoPts  = input.float(50, "Objetivo de continuación (puntos)", minval=1,
     tooltip="La tabla mostrará qué % de rupturas avanzó al menos esta cantidad de puntos.")

// ---------------- ALTO Y BAJO DEL DÍA ANTERIOR ----------------
[pdh, pdl] = request.security(syminfo.tickerid, "D",
     [high[1], low[1]], lookahead=barmerge.lookahead_on)

tDia   = time("D")
nuevoDia = na(tDia[1]) or tDia != tDia[1]
enVentana = time >= timenow - diasAnalisis * 86400000

// ------------------- ESTADO DEL DÍA ACTUAL -------------------
var float nivelAlto = na
var float nivelBajo = na
var bool  rotoAlto  = false
var bool  rotoBajo  = false
var float extAlto   = na   // máxima excursión tras romper PDH
var float extBajo   = na   // máxima excursión tras romper PDL
var float retAlto   = na   // mínimo tras romper PDH (para retroceso)
var float retBajo   = na   // máximo tras romper PDL (para retroceso)
var label lblAlto   = na
var label lblBajo   = na
var int   diasProc  = 0
var int   diasSinRuptura = 0

// ------------------- ACUMULADORES DE STATS -------------------
var float[] contAltos = array.new_float()
var float[] contBajos = array.new_float()
var float[] retrAltos = array.new_float()
var float[] retrBajos = array.new_float()

// ---------------- CIERRE DE DÍA: GUARDAR STATS ----------------
if nuevoDia
    // Finaliza los eventos del día que terminó
    if not na(nivelAlto) and enVentana[1]
        diasProc += 1
        if rotoAlto
            cont = extAlto - nivelAlto
            retr = math.max(0.0, nivelAlto - retAlto)
            array.push(contAltos, cont)
            array.push(retrAltos, retr)
            if not na(lblAlto)
                label.set_text(lblAlto, "↑ +" + str.tostring(cont, "#.#") + " pts")
        if rotoBajo
            cont = nivelBajo - extBajo
            retr = math.max(0.0, retBajo - nivelBajo)
            array.push(contBajos, cont)
            array.push(retrBajos, retr)
            if not na(lblBajo)
                label.set_text(lblBajo, "↓ +" + str.tostring(cont, "#.#") + " pts")
        if not rotoAlto and not rotoBajo
            diasSinRuptura += 1
    // Prepara el día nuevo
    nivelAlto := pdh
    nivelBajo := pdl
    rotoAlto  := false
    rotoBajo  := false
    extAlto   := na
    extBajo   := na
    retAlto   := na
    retBajo   := na
    lblAlto   := na
    lblBajo   := na

// ------------------- DETECCIÓN DE RUPTURAS -------------------
cruzaAlto = modoRuptura == "Cierre" ? close > nivelAlto : high > nivelAlto
cruzaBajo = modoRuptura == "Cierre" ? close < nivelBajo : low  < nivelBajo

if enVentana and not na(nivelAlto)
    if not rotoAlto and cruzaAlto
        rotoAlto := true
        extAlto  := high
        retAlto  := low
        lblAlto  := label.new(bar_index, nivelAlto, "↑ rompió PDH",
             style=label.style_label_down, color=color.new(color.aqua, 20),
             textcolor=color.black, size=size.small)
    else if rotoAlto
        extAlto := math.max(extAlto, high)
        retAlto := math.min(retAlto, low)

    if not rotoBajo and cruzaBajo
        rotoBajo := true
        extBajo  := low
        retBajo  := high
        lblBajo  := label.new(bar_index, nivelBajo, "↓ rompió PDL",
             style=label.style_label_up, color=color.new(color.orange, 20),
             textcolor=color.black, size=size.small)
    else if rotoBajo
        extBajo := math.min(extBajo, low)
        retBajo := math.max(retBajo, high)

// Etiqueta del día en curso (aún sin cerrar)
if barstate.islast
    if rotoAlto and not na(lblAlto)
        label.set_text(lblAlto, "↑ +" + str.tostring(extAlto - nivelAlto, "#.#") + " pts (en curso)")
    if rotoBajo and not na(lblBajo)
        label.set_text(lblBajo, "↓ +" + str.tostring(nivelBajo - extBajo, "#.#") + " pts (en curso)")

// ------------------------- VISUALES -------------------------
plot(enVentana ? nivelAlto : na, "PDH (alto de ayer)",
     color=color.new(color.aqua, 0), style=plot.style_linebr, linewidth=2)
plot(enVentana ? nivelBajo : na, "PDL (bajo de ayer)",
     color=color.new(color.orange, 0), style=plot.style_linebr, linewidth=2)

// --------------------- TABLA DE RESULTADOS ---------------------
pctObjetivo(float[] arr) =>
    n = array.size(arr)
    if n == 0
        na
    else
        cuenta = 0
        for i = 0 to n - 1
            if array.get(arr, i) >= objetivoPts
                cuenta += 1
        100.0 * cuenta / n

f(x) => na(x) ? "—" : str.tostring(x, "#.#")

var table tabla = table.new(position.top_right, 7, 5,
     bgcolor=color.new(color.black, 15), border_width=1,
     border_color=color.new(color.gray, 60))

if barstate.islast
    // Totales combinados
    tot  = array.copy(contAltos)
    array.concat(tot, contBajos)
    rtot = array.copy(retrAltos)
    array.concat(rtot, retrBajos)

    encabezado = "Días: " + str.tostring(diasProc) + " · Sin ruptura: " + str.tostring(diasSinRuptura)
    table.merge_cells(tabla, 0, 0, 6, 0)
    table.cell(tabla, 0, 0, encabezado, text_color=color.white, text_size=size.small)

    cols = array.from("", "N", "Media", "Mediana", "Máx", ">= " + str.tostring(objetivoPts, "#") + " pts", "Retroceso")
    for c = 0 to 6
        table.cell(tabla, c, 1, array.get(cols, c), text_color=color.yellow, text_size=size.small)

    filaStats(fila, nombre, float[] cont, float[] retr, colorTxt) =>
        n = array.size(cont)
        table.cell(tabla, 0, fila, nombre, text_color=colorTxt, text_size=size.small)
        table.cell(tabla, 1, fila, str.tostring(n), text_color=color.white, text_size=size.small)
        table.cell(tabla, 2, fila, n > 0 ? f(array.avg(cont))    : "—", text_color=color.white, text_size=size.small)
        table.cell(tabla, 3, fila, n > 0 ? f(array.median(cont)) : "—", text_color=color.white, text_size=size.small)
        table.cell(tabla, 4, fila, n > 0 ? f(array.max(cont))    : "—", text_color=color.white, text_size=size.small)
        table.cell(tabla, 5, fila, n > 0 ? f(pctObjetivo(cont)) + "%" : "—", text_color=color.white, text_size=size.small)
        table.cell(tabla, 6, fila, array.size(retr) > 0 ? f(array.avg(retr)) : "—", text_color=color.white, text_size=size.small)

    filaStats(2, "↑ PDH", contAltos, retrAltos, color.aqua)
    filaStats(3, "↓ PDL", contBajos, retrBajos, color.orange)
    filaStats(4, "Total", tot, rtot, color.white)
